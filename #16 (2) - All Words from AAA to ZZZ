#include <iostream>   
using namespace std;

void printalllettersfromAAAtoZZZ()
{
    string word = " ";
    cout << "\n";
    for (int i = 65; i <=90 ; i++)
    {
        for (int j = 65; j <= 90; j++)
        {
            for (int m = 65; m <= 90; m++)
            { 
                word = word + char(i);
                word = word + char(j);
                word = word + char(m);

                cout << word << endl;
                word = " ";
             }
        }
        cout << "---------------------------------------------\n";
    }
}
int main()
{
    printalllettersfromAAAtoZZZ();
    return 0;
}
